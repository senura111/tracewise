{
  "name": "tracewise",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "description": "Practise Python and C++ in the browser, with friendly explanations of your mistakes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:solutions": "tsx scripts/check-solutions.ts",
    "check:explainer": "tsx scripts/check-explainer.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@lezer/cpp": "1.1.6",
    "@lezer/python": "1.1.19",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@yowasp/clang": "22.0.0-git20542-10",
    "gifenc": "1.0.3",
    "marked": "18.1.2",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "pyodide": "314.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
